# Copie ce fichier en ".env" (même dossier) et remplis les valeurs. Ne publie JAMAIS le vrai .env.
SECRET_KEY=change-moi
DEBUG=True
FRONTEND_URL=http://localhost:5173

# ---- Base de données locale (PostgreSQL) ----
DB_ENGINE=django.db.backends.postgresql
DB_NAME=magasin_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# ---- En ligne (Neon) : remplace les 6 lignes DB_* ci-dessus ----
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote.neon.tech/neondb?sslmode=require

# ---- Emails (mot de passe oublié) ----
# Rien de rempli = les emails s'affichent dans la console.
# Hébergé sur Render gratuit : utiliser Brevo (API), le SMTP y est bloqué.
# BREVO_API_KEY=
# EMAIL_EXPEDITEUR=adresse-verifiee-dans-brevo@exemple.com
